<%# Turbo Stream target "reviews": replaced when a review is added %>
<section id="reviews" aria-labelledby="reviews-title">
  <div class="sg-section-title">
    <h2 id="reviews-title"><%= icon("fa-comments") %> <%= t("reviews.list.title") %> <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis"><%= reviews.size %></span></h2>
  </div>
  <p class="sg-caption"><%= t("reviews.list.caption") %></p>

  <% if reviews.any? %>
    <ol class="sg-reviews">
      <%= render partial: "reviews/review", collection: reviews %>
    </ol>
  <% else %>
    <p class="sg-empty-compact"><%= t("reviews.list.empty") %></p>
  <% end %>
</section>
