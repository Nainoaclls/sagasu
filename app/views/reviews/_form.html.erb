<%# Turbo Stream target "review_form": replaced by a blank form after a review is shared, or with errors %>
<%= form_with model: [supplier, review], id: "review_form", data: { controller: "visibility" } do |f| %>
  <% if review.errors.any? %>
    <div class="alert alert-danger small" role="alert">
      <p class="fw-bold mb-1">Please fix:</p>
      <ul class="mb-0"><% review.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <fieldset class="mb-3">
    <legend class="form-label">Rating</legend>
    <div class="sg-rating">
      <% 5.downto(1) do |value| %>
        <%= f.radio_button :rating, value, id: "review_rating_#{value}" %>
        <label for="review_rating_<%= value %>"><span aria-hidden="true">★</span><span class="visually-hidden"><%= pluralize(value, "star") %></span></label>
      <% end %>
    </div>
  </fieldset>

  <div class="mb-3">
    <%= f.label :comment, "What happened?", class: "form-label" %>
    <%= f.text_area :comment, rows: 4, class: "form-control", required: true, maxlength: 2000,
                    placeholder: "Facts help most: delivery on time, quality checks, responsiveness…" %>
  </div>

  <fieldset class="mb-3">
    <legend class="form-label">Who can see it</legend>
    <div class="sg-choice">
      <%= f.radio_button :visibility, "organization", id: "review_visibility_organization", data: { action: "visibility#toggle" } %>
      <label for="review_visibility_organization">
        <%= icon("fa-building") %>
        <span><strong>All buyers</strong><span>Shared across the organization.</span></span>
      </label>
      <%= f.radio_button :visibility, "project", id: "review_visibility_project", data: { action: "visibility#toggle" } %>
      <label for="review_visibility_project">
        <%= icon("fa-lock") %>
        <span><strong>One project only</strong><span>Only people on that bidder list.</span></span>
      </label>
    </div>
  </fieldset>

  <div class="mb-3" data-visibility-target="project">
    <%= f.label :project_id, "Project", class: "form-label" %>
    <%= f.collection_select :project_id, projects, :id, :title, { include_blank: "Choose a project" },
                            class: "form-select", data: { visibility_target: "select" } %>
  </div>

  <div class="form-check mb-3">
    <%= f.check_box :ai_usable, class: "form-check-input" %>
    <%= f.label :ai_usable, class: "form-check-label small" do %>
      Sagasu AI may use this when suggesting suppliers, without showing my name or quoting it.
    <% end %>
  </div>

  <%= f.button class: "btn btn-primary w-100", data: { controller: "ripple", action: "click->ripple#burst" } do %>
    <%= icon("fa-paper-plane") %> Share review
  <% end %>
<% end %>
