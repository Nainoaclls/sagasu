<li class="card card-body sg-review sg-appear" id="<%= dom_id(review) %>">
  <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
    <div class="d-flex align-items-center gap-2">
      <%= stars(review.rating) %>
      <span class="small fw-bold"><%= review_author(review) %></span>
      <span class="sg-caption">· <%= t("reviews.time_ago", time: time_ago_in_words(review.created_at)) %></span>
    </div>
    <div class="d-flex flex-wrap gap-1">
      <%= review_status_badge(review) %>
      <%= review_visibility_badge(review) %>
    </div>
  </div>
  <p class="mb-0"><%= review.comment %></p>
  <% if policy(review).update? %>
    <div class="d-flex flex-wrap gap-2 mt-3" role="group" aria-label="<%= t("review_verification.group_label") %>">
      <% Review.statuses.each_key do |status| %>
        <% next if status == review.status %>
        <%= button_to t("review_verification.actions.#{status}"), review_path(review), method: :patch,
                      params: { review: { status: status } }, class: "btn btn-quiet btn-sm" %>
      <% end %>
    </div>
  <% end %>
</li>
