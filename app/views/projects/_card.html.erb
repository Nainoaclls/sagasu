<div class="col-md-6 col-xl-4" data-filter-target="item" data-status="<%= project.status %>">
  <article class="card card-body h-100 sg-card-interactive sg-project-card sg-reveal">
    <div class="sg-card-head">
      <div>
        <p class="sg-caption mb-1"><%= project.erp_rfq.presence || t("projects.card.no_erp") %></p>
        <h3><%= link_to project.title, project, class: "sg-stretched text-decoration-none" %></h3>
      </div>
      <%= project_status_badge(project) %>
    </div>

    <p class="sg-project-meta">
      <span><%= icon("fa-building") %> <%= project.client_name.presence || t("projects.card.client_to_set") %></span>
      <span><%= icon("fa-location-dot") %> <%= project.client_area.presence || t("projects.card.area_to_set") %></span>
    </p>

    <ul class="sg-project-counts" aria-label="<%= t("projects.card.contents_label") %>">
      <li><%= t("projects.card.materials_html", count: project.items.size) %></li>
      <li><%= t("projects.card.groups_html", count: project.item_groups.size) %></li>
      <li><%= t("projects.card.suppliers_html", count: project.selected_suppliers_size) %></li>
    </ul>

    <div class="progress" role="progressbar" aria-label="<%= t("projects.card.progress_label") %>" aria-valuemin="0" aria-valuemax="100"
         aria-valuenow="<%= project_progress(project) %>">
      <div class="progress-bar" style="width: <%= project_progress(project) %>%"></div>
    </div>

    <p class="sg-caption mt-2 mb-0">
      <% if project.user_id != current_user.id %><%= t("projects.card.by", name: project.user.name) %> · <% end %>
      <%= t("projects.card.updated", time: time_ago_in_words(project.updated_at)) %>
    </p>
  </article>
</div>
