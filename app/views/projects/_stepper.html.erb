<ol id="project_stepper" class="sg-stepper mb-4" aria-label="<%= t("projects.stepper.label") %>">
  <% ProjectsHelper::STEPS.each_with_index do |key, index| %>
    <% state = step_state(project, key) %>
    <li class="is-<%= state %>" <%= "aria-current=step" if state == :current %>>
      <span class="sg-step-dot"><%= state == :done ? icon("fa-check") : index + 1 %></span>
      <%= t("projects.steps.#{key}") %>
      <span class="visually-hidden">(<%= t("projects.step_states.#{state}") %>)</span>
    </li>
  <% end %>
</ol>
