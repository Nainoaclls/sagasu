<% content_for :title, @project.title %>
<% can_edit = policy(@project).edit_content? %>
<%# Action Cable subscription: AI jobs broadcast toasts and page refreshes to everyone viewing this project %>
<%= turbo_stream_from @project %>

<div class="sg-container sg-page sg-workspace">
  <nav aria-label="Breadcrumb" class="mb-3 d-flex justify-content-between flex-wrap gap-2">
    <%= link_to projects_path, class: "small" do %><%= icon("fa-arrow-left") %> <%= t("projects.show.all_projects") %><% end %>
    <%= link_to project_activity_path(@project), class: "small" do %><%= icon("fa-clock-rotate-left") %> <%= t("project_activities.show.link") %><% end %>
  </nav>

  <header class="sg-project-head">
    <div>
      <p class="sg-eyebrow mb-1"><%= icon("fa-file-signature") %> <%= @project.erp_rfq.presence || t("projects.show.rfq_default") %></p>
      <h1><%= @project.title %></h1>
      <ul class="sg-project-facts" aria-label="<%= t("projects.show.facts_label") %>">
        <li><%= icon("fa-building") %> <%= @project.client_name.presence || t("projects.show.client_to_set") %></li>
        <li><%= icon("fa-location-dot") %> <%= t("projects.show.delivery", area: @project.client_area.presence || t("projects.show.area_to_set")) %></li>
        <li><%= icon("fa-wallet") %> <%= t("projects.show.budget", amount: money(@project.budget_amount, @project.budget_currency)) %></li>
        <li><%= icon("fa-user") %> <%= t("projects.show.buyer", name: @project.user.name) %></li>
      </ul>
    </div>
    <%= project_status_badge(@project) %>
  </header>

  <% if @project.scope.present? %>
    <blockquote class="sg-need">
      <%= icon("fa-quote-left") %>
      <p><%= @project.scope %></p>
    </blockquote>
  <% end %>

  <%= render "projects/stepper", project: @project %>

  <%= render "projects/approval_banner", project: @project, pending_approval: @pending_approval %>

  <div class="row g-4 align-items-start">
    <div class="col-lg-8">
      <%= render "projects/materials", project: @project, can_edit: can_edit %>
      <%= render "projects/groups", project: @project, can_edit: can_edit %>
    </div>

    <aside class="col-lg-4 sg-sticky-lg" aria-label="<%= t("projects.show.bidder_list_label") %>">
      <%= render "projects/bidder_list", project: @project, approvers: @approvers %>
    </aside>
  </div>
</div>
