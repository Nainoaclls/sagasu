<% content_for :title, @project.title %>
<% can_edit = policy(@project).edit_content? %>

<div class="sg-container sg-page sg-workspace">
  <nav aria-label="Breadcrumb" class="mb-3">
    <%= link_to projects_path, class: "small" do %><%= icon("fa-arrow-left") %> All projects<% end %>
  </nav>

  <header class="sg-project-head">
    <div>
      <p class="sg-eyebrow mb-1"><%= icon("fa-file-signature") %> <%= @project.erp_rfq.presence || "RFQ project" %></p>
      <h1><%= @project.title %></h1>
      <ul class="sg-project-facts" aria-label="Project details">
        <li><%= icon("fa-building") %> <%= @project.client_name.presence || "Client to set" %></li>
        <li><%= icon("fa-location-dot") %> Delivery: <%= @project.client_area.presence || "to set" %></li>
        <li><%= icon("fa-wallet") %> Budget: <%= money(@project.budget_amount, @project.budget_currency) %></li>
        <li><%= icon("fa-user") %> Buyer: <%= @project.user.name %></li>
      </ul>
    </div>
    <%= project_status_badge(@project) %>
  </header>

  <% if @project.scope.present? %>
    <blockquote class="sg-need">
      <%= icon("fa-quote-left") %>
      <p><%= @project.scope %></p>
    </blockquote>
  <% end %>

  <ol class="sg-stepper mb-4" aria-label="Bidder list progress">
    <% ProjectsHelper::STEPS.each_with_index do |(key, label), index| %>
      <% state = step_state(@project, key) %>
      <li class="is-<%= state %>" <%= "aria-current=step" if state == :current %>>
        <span class="sg-step-dot"><%= state == :done ? icon("fa-check") : index + 1 %></span>
        <%= label %>
        <span class="visually-hidden">(<%= { done: "done", current: "current step", todo: "to do" }[state] %>)</span>
      </li>
    <% end %>
  </ol>

  <%= render "projects/approval_banner", project: @project, pending_approval: @pending_approval %>

  <div class="sg-workspace-grid">
    <div class="sg-workspace-main">
      <%= render "projects/materials", project: @project, can_edit: can_edit %>
      <%= render "projects/groups", project: @project, can_edit: can_edit %>
    </div>

    <aside class="sg-workspace-aside" aria-label="Bidder list">
      <%= render "projects/bidder_list", project: @project, approvers: @approvers %>
    </aside>
  </div>
</div>
