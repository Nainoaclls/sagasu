<div id="bidder_list">
<div class="card card-body sg-bidder-card">
  <div class="sg-section-title mb-2">
    <h2><%= icon("fa-list-check") %> <%= t("projects.bidder_list.title") %></h2>
    <span class="badge rounded-pill text-bg-accent" aria-label="<%= t("projects.bidder_list.selected_label", count: project.selected_suppliers_size) %>"><%= project.selected_suppliers_size %></span>
  </div>

  <% if project.item_groups.empty? %>
    <p class="text-muted small mb-0"><%= t("projects.bidder_list.empty_hint") %></p>
  <% else %>
    <ul class="sg-bidder-groups">
      <% project.item_groups.each do |group| %>
        <% selected = group.group_suppliers.select(&:selected?) %>
        <li>
          <span class="sg-bidder-group-title"><%= group.title %></span>
          <% if selected.any? %>
            <ul><% selected.each do |link| %><li><%= icon("fa-check") %> <%= link.supplier.name %></li><% end %></ul>
          <% else %>
            <p class="sg-caption mb-0"><%= icon("fa-circle-exclamation") %> <%= t("projects.bidder_list.no_supplier_yet") %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if policy(project).submit? %>
    <hr class="sg-divider">
    <% if project.ready_for_approval? %>
      <%# :approval scope (no object): buyer_comment belongs to the project, not to the approval %>
      <%= simple_form_for :approval, url: project_approvals_path(project), html: { class: "sg-submit-form" } do |f| %>
        <h3 class="h6"><%= icon("fa-paper-plane") %> <%= t("projects.bidder_list.send_title") %></h3>
        <%= f.input :approver_id, label: t("projects.bidder_list.approver_label"), collection: approvers, label_method: :name, value_method: :id,
                    prompt: t("projects.bidder_list.approver_prompt"), required: true %>
        <%= f.input :buyer_comment, as: :text, label: t("projects.bidder_list.comment_label"), required: false,
                    input_html: { rows: 3, maxlength: 1000, value: project.buyer_comment,
                                  placeholder: t("projects.bidder_list.comment_placeholder") } %>
        <%= f.button :button, class: "btn-primary w-100", data: { controller: "ripple", action: "click->ripple#burst" } do %>
          <%= icon("fa-paper-plane") %> <%= t("projects.bidder_list.send") %>
        <% end %>
      <% end %>
    <% else %>
      <div class="sg-checklist" role="status">
        <p class="fw-bold small mb-2"><%= t("projects.bidder_list.checklist_title") %></p>
        <ul>
          <% project.submission_blockers.each do |blocker| %>
            <li><%= icon("fa-circle", style: "regular") %> <%= blocker %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>
</div>

<% if project.approvals.any? %>
  <section class="card card-body mt-3" aria-labelledby="history-title">
    <h2 id="history-title" class="h6 mb-3"><%= icon("fa-clock-rotate-left") %> <%= t("projects.bidder_list.history_title") %></h2>
    <ol class="sg-timeline">
      <% project.approvals.reverse_each do |approval| %>
        <li>
          <div class="d-flex justify-content-between align-items-center gap-2">
            <span class="small fw-bold"><%= approval.approver.name %></span>
            <%= approval_status_badge(approval) %>
          </div>
          <p class="sg-caption mb-1">
            <%= t("projects.bidder_list.sent", time: l(approval.created_at, format: :short)) %>
            <% if approval.decided_at && !approval.withdrawn? %> · <%= t("projects.bidder_list.decided", time: l(approval.decided_at, format: :short)) %><% end %>
          </p>
          <% if approval.comment.present? %><p class="small mb-1">“<%= approval.comment %>”</p><% end %>
          <details class="sg-snapshot">
            <summary><%= t("projects.bidder_list.snapshot", count: approval.snapshot_supplier_count) %></summary>
            <% approval.snapshot_groups.each do |group| %>
              <p class="fw-bold small mb-1 mt-2"><%= group["title"] %></p>
              <ul class="small mb-0">
                <% Array(group["suppliers"]).each do |supplier| %><li><%= supplier["name"] %></li><% end %>
              </ul>
            <% end %>
          </details>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>
</div>
