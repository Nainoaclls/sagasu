<%# Banner above the workspace: returned comment, waiting state, or the approver's decision form %>
<% latest = project.latest_approval %>

<% if pending_approval && policy(pending_approval).update? %>
  <%= render "approvals/decision", approval: pending_approval %>
<% elsif project.pending_approval? && latest %>
  <div class="sg-banner is-pending" role="status">
    <%= icon("fa-hourglass-half") %>
    <div>
      <strong><%= t("projects.approval_banner.waiting", name: latest.approver.name) %></strong>
      <p><%= t("projects.approval_banner.waiting_text", time: time_ago_in_words(latest.created_at)) %></p>
      <p class="small mb-0"><%= link_to document_approval_path(latest, format: :pdf) do %><%= icon("fa-file-pdf") %> <%= t("approval_document.link") %><% end %></p>
      <% if policy(latest).withdraw? %>
        <%= button_to withdraw_approval_path(latest), method: :patch, class: "btn btn-outline-primary btn-sm mt-2",
                      form: { data: { turbo_confirm: t("submission_withdrawal.confirm", name: latest.approver.name) } } do %>
          <%= icon("fa-rotate-left") %> <%= t("submission_withdrawal.button") %>
        <% end %>
      <% end %>
    </div>
  </div>
<% elsif project.returned? && latest&.returned? %>
  <div class="sg-banner is-returned" role="status">
    <%= icon("fa-rotate-left") %>
    <div>
      <strong><%= t("projects.approval_banner.returned", name: latest.approver.name) %></strong>
      <p>“<%= latest.comment %>”</p>
      <p class="small mb-0"><%= t("projects.approval_banner.returned_hint") %></p>
      <p class="small mb-0"><%= link_to document_approval_path(latest, format: :pdf) do %><%= icon("fa-file-pdf") %> <%= t("approval_document.link") %><% end %></p>
    </div>
  </div>
<% elsif project.approved? && latest&.approved? %>
  <div class="sg-banner is-approved" role="status">
    <span class="sg-hanko sg-hanko-sm" aria-hidden="true">承認</span>
    <div>
      <strong><%= t("projects.approval_banner.approved", name: latest.approver.name) %></strong>
      <p><%= latest.comment.presence || t("projects.approval_banner.approved_default") %></p>
      <p class="small mb-0"><%= link_to document_approval_path(latest, format: :pdf) do %><%= icon("fa-file-pdf") %> <%= t("approval_document.link") %><% end %></p>
    </div>
  </div>
<% end %>
