<% content_for :title, @supplier.name %>
<% verified = @reviews.select(&:verified?) %>

<div class="sg-container sg-page">
  <nav aria-label="Breadcrumb" class="mb-3">
    <%= link_to suppliers_path, class: "small" do %><%= icon("fa-arrow-left") %> All suppliers<% end %>
  </nav>

  <header class="sg-supplier-head sg-card">
    <span class="sg-supplier-avatar" aria-hidden="true"><%= icon(MaterialCategory.icon(@supplier.category)) %></span>
    <div class="flex-grow-1">
      <p class="sg-eyebrow mb-1"><%= @supplier.category_label %></p>
      <h1><%= @supplier.name %></h1>
      <ul class="sg-project-facts">
        <li><%= icon("fa-location-dot") %> <%= @supplier.location %></li>
        <% if @supplier.erp_vendor_code.present? %><li><%= icon("fa-barcode") %> ERP <%= @supplier.erp_vendor_code %></li><% end %>
        <% if (website = safe_external_url(@supplier.website)) %>
          <li><%= link_to website, target: "_blank", rel: "noopener noreferrer" do %><%= icon("fa-arrow-up-right-from-square") %> Website<span class="visually-hidden"> (opens in a new tab)</span><% end %></li>
        <% end %>
      </ul>
    </div>
    <div class="sg-supplier-score">
      <% if verified.any? %>
        <%= stars(verified.sum(&:rating) / verified.size.to_f) %>
        <p class="sg-caption mb-0"><%= pluralize(verified.size, "verified review") %></p>
      <% else %>
        <span class="sg-badge sg-badge-outline">No verified review yet</span>
      <% end %>
    </div>
  </header>

  <div class="sg-supplier-layout">
    <div>
      <section class="sg-card mb-4" aria-labelledby="facts-title">
        <h2 id="facts-title" class="h5 mb-3"><%= icon("fa-clipboard-check") %> Supplier record</h2>
        <% if @supplier.description.present? %><p><%= @supplier.description %></p><% end %>
        <dl class="sg-facts">
          <%= supplier_fact("Monthly capacity", @supplier.capacity_label) %>
          <%= supplier_fact("Lead time", (@supplier.lead_time_days && "#{@supplier.lead_time_days} days")) %>
          <%= supplier_fact("Delivers to", @supplier.delivery_areas.join(", ").presence) %>
          <%= supplier_fact("Certifications", @supplier.certifications.join(", ").presence) %>
          <%= supplier_fact("Tax ID", @supplier.tax_id) %>
        </dl>
        <% if (source = safe_external_url(@supplier.source_url)) %>
          <p class="sg-caption mt-3 mb-0"><%= icon("fa-link") %> Source: <%= link_to source, source, target: "_blank", rel: "noopener noreferrer" %></p>
        <% end %>
      </section>

      <%= render "reviews/list", reviews: @reviews %>
    </div>

    <aside aria-labelledby="review-form-title">
      <div class="sg-card sg-review-form">
        <h2 id="review-form-title" class="h5"><%= icon("fa-pen-to-square") %> Share an observation</h2>
        <%= render "reviews/form", supplier: @supplier, review: @review, projects: @review_projects %>
      </div>
    </aside>
  </div>
</div>
