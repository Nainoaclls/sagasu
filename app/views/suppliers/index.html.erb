<% content_for :title, t("suppliers.index.title") %>

<div class="sg-container sg-page">
  <header class="sg-page-head">
    <div>
      <h1><%= t("suppliers.index.title") %></h1>
      <p><%= t("suppliers.index.lead") %></p>
    </div>
  </header>

  <%# Le Wagon search pattern: GET form_with, results in a Turbo Frame %>
  <%= form_with url: suppliers_path, method: :get, class: "card card-body p-3 mb-4", role: "search",
        data: { controller: "autosubmit", turbo_frame: "supplier_results", turbo_action: "advance" } do |f| %>
    <div class="row g-2">
      <div class="col-md-6 sg-search">
        <%= icon("fa-magnifying-glass") %>
        <%= f.label :query, t("suppliers.index.search_label"), class: "visually-hidden" %>
        <%= f.search_field :query, value: params[:query], class: "form-control", autocomplete: "off",
                           placeholder: t("suppliers.index.search_placeholder"), data: { action: "input->autosubmit#debounced" } %>
      </div>
      <div class="col-md-3">
        <%= f.label :category, t("suppliers.index.material_label"), class: "visually-hidden" %>
        <%= f.select :category, MaterialCategory.options, { include_blank: t("suppliers.index.all_materials"), selected: params[:category] },
                     class: "form-select", data: { controller: "tom-select", action: "change->autosubmit#now" } %>
      </div>
      <div class="col-md-3">
        <%= f.label :area, t("suppliers.index.area_label"), class: "visually-hidden" %>
        <%= f.select :area, Prefecture::ALL, { include_blank: t("suppliers.index.any_area"), selected: params[:area] },
                     class: "form-select", data: { controller: "tom-select", action: "change->autosubmit#now" } %>
      </div>
    </div>
    <noscript><%= f.submit t("suppliers.index.search"), class: "btn btn-primary mt-2" %></noscript>
  <% end %>

  <%= render "suppliers/map", suppliers: @map_suppliers, title: t("suppliers.index.map_title") %>

  <%= turbo_frame_tag "supplier_results", data: { turbo_action: "advance" } do %>
    <p class="sg-results-count" role="status">
      <strong><%= number_with_delimiter(@total) %></strong> <%= t("suppliers.index.results", count: @total) %>
      <% if params[:query].present? %> <%= t("suppliers.index.results_for", query: params[:query]) %><% end %>
    </p>

    <% if @suppliers.any? %>
      <div class="row g-3" data-controller="reveal">
        <% @suppliers.each do |supplier| %>
          <div class="col-sm-6 col-lg-4">
          <article class="card card-body h-100 sg-card-interactive sg-supplier-card sg-reveal">
            <div class="d-flex align-items-start gap-3">
              <span class="sg-group-icon" aria-hidden="true"><%= icon(MaterialCategory.icon(supplier.category)) %></span>
              <div class="min-w-0">
                <h2 class="h6 mb-1"><%= link_to supplier.name, supplier, class: "sg-stretched", data: { turbo_frame: "_top" } %></h2>
                <p class="sg-caption mb-0"><%= supplier.category_label %></p>
              </div>
            </div>
            <ul class="sg-supplier-facts">
              <li><%= icon("fa-location-dot") %> <%= supplier.location %></li>
              <li><%= icon("fa-gauge-high") %> <%= supplier.capacity_label || t("suppliers.index.capacity_to_confirm") %></li>
              <li><%= icon("fa-truck-fast") %> <%= supplier.lead_time_days ? t("suppliers.index.lead_time", count: supplier.lead_time_days) : t("suppliers.index.lead_time_to_confirm") %></li>
            </ul>
            <% if supplier.missing_details.any? %>
              <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis"><%= icon("fa-circle-question") %> <%= t("suppliers.index.details_to_confirm", count: supplier.missing_details.size) %></span>
            <% else %>
              <span class="badge rounded-pill bg-success-subtle text-success-emphasis"><%= icon("fa-circle-check") %> <%= t("suppliers.index.complete_record") %></span>
            <% end %>
          </article>
          </div>
        <% end %>
      </div>

      <% pages = [(@total / SuppliersController::PER_PAGE.to_f).ceil, 1].max %>
      <nav aria-label="<%= t("suppliers.index.pages_label") %>">
        <ul class="pagination justify-content-center mt-4">
          <li class="page-item <%= 'disabled' if @page == 1 %>">
            <%= link_to_if @page > 1, safe_join([icon("fa-arrow-left"), " #{t("suppliers.index.previous")}"]),
                  suppliers_path(request.query_parameters.merge(page: @page - 1)), class: "page-link" do |label| %>
              <span class="page-link"><%= label %></span>
            <% end %>
          </li>
          <li class="page-item active" aria-current="page"><span class="page-link"><%= t("suppliers.index.page_of", page: @page, pages: pages) %></span></li>
          <li class="page-item <%= 'disabled' if @page >= pages %>">
            <%= link_to_if @page < pages, safe_join(["#{t("suppliers.index.next")} ", icon("fa-arrow-right")]),
                  suppliers_path(request.query_parameters.merge(page: @page + 1)), class: "page-link" do |label| %>
              <span class="page-link"><%= label %></span>
            <% end %>
          </li>
        </ul>
      </nav>
    <% else %>
      <div class="sg-empty">
        <%= image_tag "mascot/research.webp", alt: "", width: 120, height: 80, class: "rounded-3" %>
        <div>
          <h2 class="h3"><%= t("suppliers.index.empty_title") %></h2>
          <p><%= t("suppliers.index.empty_text") %></p>
          <%= link_to t("suppliers.index.clear_search"), suppliers_path, class: "btn btn-outline-primary btn-sm", data: { turbo_frame: "_top" } %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
