<% content_for :title, "Suppliers" %>

<div class="sg-container sg-page">
  <header class="sg-page-head">
    <div>
      <h1>Suppliers</h1>
      <p>Search your supplier records by name, city or material. Missing details are shown as “to confirm”.</p>
    </div>
  </header>

  <%# Le Wagon search pattern: GET form_with, results in a Turbo Frame %>
  <%= form_with url: suppliers_path, method: :get, class: "card card-body p-3 mb-4", role: "search",
        data: { controller: "autosubmit", turbo_frame: "supplier_results", turbo_action: "advance" } do |f| %>
    <div class="row g-2">
      <div class="col-md-6 sg-search">
        <%= icon("fa-magnifying-glass") %>
        <%= f.label :query, "Search suppliers", class: "visually-hidden" %>
        <%= f.search_field :query, value: params[:query], class: "form-control", autocomplete: "off",
                           placeholder: "Bricks, Saitama, insulation…", data: { action: "input->autosubmit#debounced" } %>
      </div>
      <div class="col-md-3">
        <%= f.label :category, "Material", class: "visually-hidden" %>
        <%= f.select :category, MaterialCategory.options, { include_blank: "All materials", selected: params[:category] },
                     class: "form-select", data: { controller: "tom-select", action: "change->autosubmit#now" } %>
      </div>
      <div class="col-md-3">
        <%= f.label :area, "Delivers to", class: "visually-hidden" %>
        <%= f.select :area, Prefecture::ALL, { include_blank: "Any delivery area", selected: params[:area] },
                     class: "form-select", data: { controller: "tom-select", action: "change->autosubmit#now" } %>
      </div>
    </div>
    <noscript><%= f.submit "Search", class: "btn btn-primary mt-2" %></noscript>
  <% end %>

  <%= turbo_frame_tag "supplier_results", data: { turbo_action: "advance" } do %>
    <p class="sg-results-count" role="status">
      <strong><%= number_with_delimiter(@total) %></strong> <%= "supplier".pluralize(@total) %>
      <% if params[:query].present? %> for “<%= params[:query] %>”<% end %>
    </p>

    <% if @suppliers.any? %>
      <div class="row g-3" data-controller="reveal">
        <% @suppliers.each do |supplier| %>
          <div class="col-sm-6 col-lg-4">
          <article class="card card-body h-100 sg-card-interactive sg-supplier-card sg-reveal">
            <div class="d-flex align-items-start gap-3">
              <span class="sg-group-icon" aria-hidden="true"><%= icon(MaterialCategory.icon(supplier.category)) %></span>
              <div class="min-w-0">
                <h2 class="h6 mb-1"><%= link_to supplier.name, supplier, class: "sg-stretched", data: { turbo_frame: "_top" } %></h2>
                <p class="sg-caption mb-0"><%= supplier.category_label %></p>
              </div>
            </div>
            <ul class="sg-supplier-facts">
              <li><%= icon("fa-location-dot") %> <%= supplier.location %></li>
              <li><%= icon("fa-gauge-high") %> <%= supplier.capacity_label || "Capacity to confirm" %></li>
              <li><%= icon("fa-truck-fast") %> <%= supplier.lead_time_days ? "#{supplier.lead_time_days}-day lead time" : "Lead time to confirm" %></li>
            </ul>
            <% if supplier.missing_details.any? %>
              <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis"><%= icon("fa-circle-question") %> <%= pluralize(supplier.missing_details.size, "detail") %> to confirm</span>
            <% else %>
              <span class="badge rounded-pill bg-success-subtle text-success-emphasis"><%= icon("fa-circle-check") %> Complete record</span>
            <% end %>
          </article>
          </div>
        <% end %>
      </div>

      <% pages = [(@total / SuppliersController::PER_PAGE.to_f).ceil, 1].max %>
      <nav aria-label="Pages">
        <ul class="pagination justify-content-center mt-4">
          <li class="page-item <%= 'disabled' if @page == 1 %>">
            <%= link_to_if @page > 1, safe_join([icon("fa-arrow-left"), " Previous"]),
                  suppliers_path(request.query_parameters.merge(page: @page - 1)), class: "page-link" do |label| %>
              <span class="page-link"><%= label %></span>
            <% end %>
          </li>
          <li class="page-item active" aria-current="page"><span class="page-link">Page <%= @page %> of <%= pages %></span></li>
          <li class="page-item <%= 'disabled' if @page >= pages %>">
            <%= link_to_if @page < pages, safe_join(["Next ", icon("fa-arrow-right")]),
                  suppliers_path(request.query_parameters.merge(page: @page + 1)), class: "page-link" do |label| %>
              <span class="page-link"><%= label %></span>
            <% end %>
          </li>
        </ul>
      </nav>
    <% else %>
      <div class="sg-empty">
        <%= image_tag "mascot/research.webp", alt: "", width: 120, height: 80, class: "rounded-3" %>
        <div>
          <h2 class="h3">No supplier matched</h2>
          <p>Try a broader word (for example “brick” instead of a product code) or another delivery area.</p>
          <%= link_to "Clear the search", suppliers_path, class: "btn btn-outline-primary btn-sm", data: { turbo_frame: "_top" } %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
