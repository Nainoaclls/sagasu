<%# Two-column shell for every authentication page: brand story on the left, form on the right %>
<div class="sg-auth">
  <div class="sg-auth-art sg-on-dark">
    <div>
      <p class="sg-eyebrow" style="color: #A3CDD6"><%= icon("fa-helmet-safety") %> <%= t("devise_views.shared.art_eyebrow") %></p>
      <h2><%= t("devise_views.shared.art_title") %></h2>
      <p><%= t("devise_views.shared.art_text") %></p>
    </div>
    <%= image_tag "mascot/welcome.webp", alt: "", width: 640, height: 708 %>
  </div>
  <div class="sg-auth-form">
    <div class="sg-auth-card">
      <%= yield %>
    </div>
  </div>
</div>
