<% content_for :title, t("devise_views.passwords.edit.title") %>
<%= render layout: "devise/shared/auth_shell" do %>
  <h1><%= t("devise_views.passwords.edit.heading") %></h1>

  <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= f.error_notification %>
    <%= f.input :reset_password_token, as: :hidden %>
    <%= f.full_error :reset_password_token %>
    <%= f.input :password, label: t("devise_views.passwords.edit.new_password"), required: true, autofocus: true,
                hint: (t("devise_views.passwords.edit.password_hint", count: @minimum_password_length) if @minimum_password_length),
                input_html: { autocomplete: "new-password" } %>
    <%= f.input :password_confirmation, label: t("devise_views.passwords.edit.confirm_password"), required: true, input_html: { autocomplete: "new-password" } %>
    <%= f.button :button, t("devise_views.passwords.edit.submit"), class: "btn btn-primary btn-lg w-100" %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
