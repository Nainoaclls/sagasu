<% content_for :title, t("pages.home.title") %>

<section class="sg-hero" aria-labelledby="hero-title">
  <div class="sg-container">
   <div class="row g-5 align-items-center">
    <div class="col-lg-6 sg-hero-copy" data-controller="reveal">
      <p class="sg-eyebrow sg-reveal"><%= icon("fa-helmet-safety") %> <%= t("pages.home.eyebrow") %></p>
      <h1 id="hero-title" class="sg-reveal"><%= t("pages.home.heading_a") %> <span class="sg-highlight"><%= t("pages.home.heading_b") %></span></h1>
      <p class="lead sg-reveal"><%= t("pages.home.lead") %></p>
      <div class="sg-hero-actions sg-reveal">
        <% if user_signed_in? %>
          <%= link_to projects_path, class: "btn btn-primary btn-lg", data: { controller: "ripple", action: "click->ripple#burst" } do %>
            <%= t("pages.home.cta_projects") %> <%= icon("fa-arrow-right") %>
          <% end %>
        <% else %>
          <%= link_to new_user_registration_path, class: "btn btn-primary btn-lg", data: { controller: "ripple", action: "click->ripple#burst" } do %>
            <%= t("pages.home.cta_start") %> <%= icon("fa-arrow-right") %>
          <% end %>
          <%= link_to t("shared.navbar.log_in"), new_user_session_path, class: "btn btn-outline-primary btn-lg" %>
        <% end %>
      </div>
      <ul class="sg-hero-proof sg-reveal">
        <li><%= icon("fa-circle-check") %> <%= t("pages.home.proof_evidence") %></li>
        <li><%= icon("fa-circle-check") %> <%= t("pages.home.proof_flagged") %></li>
        <li><%= icon("fa-circle-check") %> <%= t("pages.home.proof_human") %></li>
      </ul>
    </div>

    <div class="col-lg-6 sg-hero-stage" data-controller="tilt" data-action="mousemove->tilt#move mouseleave->tilt#reset">
      <figure class="sg-demo" data-controller="demo" aria-label="<%= t("pages.home.demo_aria") %>">
        <div class="sg-demo-head">
          <span class="sg-demo-dots" aria-hidden="true"><span></span><span></span><span></span></span>
          <span>Shinjuku office tower · RFQ-2026-118</span>
        </div>

        <%# Demo content (quotes, names, material lists) stays in English everywhere: it is sample data, not UI %>
        <div class="sg-demo-step" data-demo-target="step">
          <p class="sg-demo-label"><%= t("pages.home.demo_need") %></p>
          <p class="sg-demo-bubble" data-controller="typed">“Facing bricks delivered in Tokyo, 50,000 per month, plus mortar.”</p>
        </div>

        <div class="sg-demo-step" data-demo-target="step">
          <p class="sg-demo-label"><%= t("pages.home.demo_grouped") %></p>
          <div class="d-flex flex-wrap gap-2">
            <span class="sg-chip"><%= icon("fa-cubes-stacked") %> Masonry &amp; bricks · 3 items</span>
            <span class="sg-chip"><%= icon("fa-trowel") %> Mortar &amp; cement · 2 items</span>
          </div>
        </div>

        <div class="sg-demo-step" data-demo-target="step">
          <p class="sg-demo-label"><%= t("pages.home.demo_suppliers") %></p>
          <div class="sg-demo-supplier">
            <div>
              <strong>Kanto Clayworks</strong> <span class="badge rounded-pill text-bg-accent"><%= icon("fa-wand-magic-sparkles") %> AI</span>
              <p><%= icon("fa-check") %> Delivers to Tokyo · <%= icon("fa-check") %> 60,000 bricks / month</p>
            </div>
            <span class="badge rounded-pill bg-success-subtle text-success-emphasis"><%= icon("fa-check") %> <%= t("pages.home.demo_selected") %></span>
          </div>
          <div class="sg-demo-supplier">
            <div>
              <strong>Musashi Brick Co.</strong> <span class="badge rounded-pill text-bg-accent"><%= icon("fa-wand-magic-sparkles") %> AI</span>
              <p><%= icon("fa-check") %> JIS certified · <span class="sg-to-confirm"><%= icon("fa-circle-question") %> Capacity to confirm</span></p>
            </div>
            <span class="badge rounded-pill border text-body-secondary"><%= t("pages.home.demo_review") %></span>
          </div>
        </div>

        <div class="sg-demo-step sg-demo-approval" data-demo-target="step">
          <span class="sg-hanko" aria-hidden="true">承認</span>
          <div>
            <p class="sg-demo-label mb-0"><%= t("pages.home.demo_approved") %></p>
            <p class="m-0 small"><%= t("pages.home.demo_approved_detail") %></p>
          </div>
        </div>
      </figure>
    </div>
   </div>
  </div>
</section>

<section class="sg-pain" aria-labelledby="pain-title" data-controller="reveal">
  <div class="sg-container">
    <div class="sg-pain-head sg-reveal">
      <p class="sg-eyebrow"><%= t("pages.home.pain_eyebrow") %></p>
      <h2 id="pain-title"><%= t("pages.home.pain_title") %></h2>
      <p class="lead"><%= t("pages.home.pain_lead") %></p>
    </div>
    <ul class="row g-3 list-unstyled m-0">
      <li class="col-md-4">
        <div class="sg-stat sg-reveal">
          <strong data-controller="countup" data-countup-end-value="50000">50,000</strong>
          <span><%= t("pages.home.stat_bricks") %></span>
        </div>
      </li>
      <li class="col-md-4">
        <div class="sg-stat sg-reveal">
          <strong data-controller="countup" data-countup-end-value="2000">2,000</strong>
          <span><%= t("pages.home.stat_suppliers") %></span>
        </div>
      </li>
      <li class="col-md-4">
        <div class="sg-stat sg-reveal is-accent">
          <strong>0</strong>
          <span><%= t("pages.home.stat_shortlist") %></span>
        </div>
      </li>
    </ul>
  </div>
</section>

<section id="how-it-works" class="sg-steps-section" aria-labelledby="how-title" data-controller="reveal">
  <div class="sg-container">
    <p class="sg-eyebrow sg-reveal"><%= t("pages.home.how_eyebrow") %></p>
    <h2 id="how-title" class="sg-reveal"><%= t("pages.home.how_title") %></h2>
    <ol class="row g-3 list-unstyled m-0 sg-steps">
      <% icons = ["fa-clipboard-list", "fa-layer-group", "fa-wand-magic-sparkles", "fa-stamp"] %>
      <% t("pages.home.steps").each_with_index do |step, index| %>
        <li class="col-sm-6 col-lg-3">
          <div class="sg-step h-100 sg-reveal">
            <span class="sg-step-icon <%= 'is-accent' if index == 2 %>"><%= icon(icons[index]) %></span>
            <h3><%= step[:title] %></h3>
            <p><%= step[:text] %></p>
          </div>
        </li>
      <% end %>
    </ol>
  </div>
</section>

<section id="trust" class="sg-trust" aria-labelledby="trust-title" data-controller="reveal">
  <div class="sg-container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-5 sg-trust-art sg-reveal">
        <%= image_tag "mascot/welcome.webp", alt: t("pages.home.mascot_alt"), width: 640, height: 708, loading: "lazy" %>
      </div>
      <div class="col-lg-7">
        <p class="sg-eyebrow sg-reveal"><%= t("pages.home.trust_eyebrow") %></p>
        <h2 id="trust-title" class="sg-reveal"><%= t("pages.home.trust_title") %></h2>
        <div class="row g-3">
          <% icons = ["fa-magnifying-glass-chart", "fa-user-check", "fa-scale-balanced", "fa-clock-rotate-left"] %>
          <% t("pages.home.principles").each_with_index do |principle, index| %>
            <div class="col-md-6">
              <div class="card card-body h-100 flex-row gap-3 sg-principle sg-reveal">
                <%= icon(icons[index]) %>
                <div><h3><%= principle[:title] %></h3><p><%= principle[:text] %></p></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="sg-cta" aria-labelledby="cta-title" data-controller="reveal">
  <div class="sg-container">
    <div class="sg-cta-card sg-reveal">
      <div>
        <h2 id="cta-title"><%= t("pages.home.cta_title") %></h2>
        <p><%= t("pages.home.cta_text_html", suppliers: number_with_delimiter(@supplier_count), categories: @category_count) %></p>
        <%= link_to (user_signed_in? ? projects_path : new_user_registration_path), class: "btn btn-accent btn-lg",
            data: { controller: "ripple", action: "click->ripple#burst" } do %>
          <%= user_signed_in? ? t("pages.home.cta_open") : t("pages.home.cta_create") %> <%= icon("fa-arrow-right") %>
        <% end %>
      </div>
      <%= image_tag "mascot/success.webp", alt: "", width: 640, height: 567, loading: "lazy", class: "sg-cta-mascot" %>
    </div>
  </div>
</section>
