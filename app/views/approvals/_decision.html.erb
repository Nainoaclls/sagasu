<%# Story 14: shown to the assigned approver on the project page %>
<section class="sg-decision" aria-labelledby="decision-title">
  <div class="sg-decision-head">
    <span class="sg-hanko sg-hanko-sm" aria-hidden="true">確認</span>
    <div>
      <h2 id="decision-title" class="h4 mb-1"><%= t("approvals.decision.title") %></h2>
      <p class="mb-0">
        <%= t("approvals.decision.sent", name: approval.project.user.name, time: time_ago_in_words(approval.created_at),
              suppliers: t("approvals.decision.suppliers", count: approval.snapshot_supplier_count),
              groups: t("approvals.decision.groups", count: approval.snapshot_groups.size)) %>
      </p>
      <% if approval.snapshot["buyer_comment"].present? %>
        <p class="sg-buyer-comment"><%= icon("fa-comment") %> “<%= approval.snapshot["buyer_comment"] %>”</p>
      <% end %>
    </div>
  </div>

  <%= simple_form_for approval, html: { class: "sg-decision-form" } do |f| %>
    <%= f.input :comment, as: :text, label: t("approvals.decision.comment_label"), required: false,
                hint: t("approvals.decision.comment_hint"),
                input_html: { rows: 2, maxlength: 1000,
                              placeholder: t("approvals.decision.comment_placeholder") } %>
    <div class="d-flex flex-wrap gap-2 justify-content-end">
      <%= f.button :button, name: "approval[status]", value: "returned", class: "btn-outline-primary" do %>
        <%= icon("fa-rotate-left") %> <%= t("approvals.decision.return") %>
      <% end %>
      <%= f.button :button, name: "approval[status]", value: "approved", class: "btn-primary",
                   data: { controller: "ripple", action: "click->ripple#burst" } do %>
        <%= icon("fa-stamp") %> <%= t("approvals.decision.approve") %>
      <% end %>
    </div>
  <% end %>
</section>
