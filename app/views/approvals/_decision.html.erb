<%# Story 14: shown to the assigned approver on the project page %>
<section class="sg-decision" aria-labelledby="decision-title">
  <div class="sg-decision-head">
    <span class="sg-hanko sg-hanko-sm" aria-hidden="true">確認</span>
    <div>
      <h2 id="decision-title" class="h4 mb-1">Your decision</h2>
      <p class="mb-0">
        <%= approval.project.user.name %> sent this bidder list <%= time_ago_in_words(approval.created_at) %> ago:
        <%= pluralize(approval.snapshot_supplier_count, "supplier") %> in <%= pluralize(approval.snapshot_groups.size, "group") %>.
      </p>
      <% if approval.snapshot["buyer_comment"].present? %>
        <p class="sg-buyer-comment"><%= icon("fa-comment") %> “<%= approval.snapshot["buyer_comment"] %>”</p>
      <% end %>
    </div>
  </div>

  <%= simple_form_for approval, html: { class: "sg-decision-form" } do |f| %>
    <%= f.input :comment, as: :text, label: "Comment", required: false,
                hint: "The buyer sees your comment. Returning the list unlocks it for changes.",
                input_html: { rows: 2, maxlength: 1000,
                              placeholder: "Required when you return the list: what should the buyer change?" } %>
    <div class="d-flex flex-wrap gap-2 justify-content-end">
      <%= f.button :button, name: "approval[status]", value: "returned", class: "btn-ghost" do %>
        <%= icon("fa-rotate-left") %> Return to buyer
      <% end %>
      <%= f.button :button, name: "approval[status]", value: "approved", class: "btn-primary",
                   data: { controller: "ripple", action: "click->ripple#burst" } do %>
        <%= icon("fa-stamp") %> Approve bidder list
      <% end %>
    </div>
  <% end %>
</section>
