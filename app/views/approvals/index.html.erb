<% content_for :title, t("approvals.index.title") %>

<div class="sg-container sg-page" data-controller="reveal">
  <header class="sg-page-head sg-reveal">
    <div>
      <h1><%= t("approvals.index.title") %></h1>
      <p><%= t("approvals.index.lead") %></p>
    </div>
  </header>

  <section aria-labelledby="pending-title" class="mb-5">
    <div class="sg-section-title">
      <h2 id="pending-title"><%= icon("fa-hourglass-half") %> <%= t("approvals.index.pending_title") %> <span class="badge rounded-pill text-bg-accent"><%= @pending.size %></span></h2>
    </div>

    <% if @pending.any? %>
      <div class="sg-approval-list">
        <% @pending.each do |approval| %>
          <article class="card card-body sg-card-interactive sg-approval sg-reveal">
            <div class="sg-approval-main">
              <p class="sg-caption mb-1"><%= approval.project.erp_rfq.presence || t("approvals.index.rfq_default") %> · <%= t("approvals.index.sent_ago", time: time_ago_in_words(approval.created_at)) %></p>
              <h3 class="h5 mb-1"><%= link_to approval.project.title, project_path(approval.project), class: "sg-stretched text-decoration-none" %></h3>
              <p class="mb-2 text-muted small">
                <%= icon("fa-user") %> <%= approval.project.user.name %> ·
                <%= icon("fa-location-dot") %> <%= approval.project.client_area.presence || t("approvals.index.area_not_set") %>
              </p>
              <ul class="sg-project-counts mb-0">
                <li><%= t("approvals.index.groups_html", count: approval.snapshot_groups.size) %></li>
                <li><%= t("approvals.index.suppliers_html", count: approval.snapshot_supplier_count) %></li>
                <li><%= t("approvals.index.materials_html", count: approval.project.items.size) %></li>
              </ul>
              <% if approval.snapshot["buyer_comment"].present? %>
                <p class="sg-buyer-comment small"><%= icon("fa-comment") %> “<%= approval.snapshot["buyer_comment"] %>”</p>
              <% end %>
              <%= link_to document_approval_path(approval, format: :pdf), class: "sg-above-hover small d-inline-flex align-items-center gap-1" do %>
                <%= icon("fa-file-pdf") %> <%= t("approval_document.link") %>
              <% end %>
            </div>
            <span class="btn btn-primary sg-above-hover" aria-hidden="true"><%= t("approvals.index.review") %> <%= icon("fa-arrow-right") %></span>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="sg-empty sg-reveal">
        <%= image_tag "mascot/success.webp", alt: "", width: 120, height: 106 %>
        <div>
          <h3><%= t("approvals.index.caught_up_title") %></h3>
          <p><%= t("approvals.index.caught_up_text") %></p>
        </div>
      </div>
    <% end %>
  </section>

  <section aria-labelledby="decided-title">
    <div class="sg-section-title">
      <h2 id="decided-title"><%= icon("fa-clock-rotate-left") %> <%= t("approvals.index.decided_title") %></h2>
    </div>
    <% if @decided.any? %>
      <div class="card overflow-hidden">
        <div class="table-responsive">
          <table class="table table-hover align-middle sg-table">
            <caption class="visually-hidden"><%= t("approvals.index.decided_caption") %></caption>
            <thead>
              <tr>
                <th scope="col"><%= t("approvals.index.col_project") %></th>
                <th scope="col"><%= t("approvals.index.col_buyer") %></th>
                <th scope="col"><%= t("approvals.index.col_decision") %></th>
                <th scope="col"><%= t("approvals.index.col_date") %></th>
                <th scope="col"><span class="visually-hidden">PDF</span></th>
              </tr>
            </thead>
            <tbody>
              <% @decided.each do |approval| %>
                <tr>
                  <%# A withdrawn submission is no longer the approver's to open: plain title, no form %>
                  <td>
                    <% if approval.withdrawn? %>
                      <span class="fw-bold"><%= approval.project.title %></span>
                    <% else %>
                      <%= link_to approval.project.title, project_path(approval.project), class: "fw-bold" %>
                    <% end %>
                  </td>
                  <td><%= approval.project.user.name %></td>
                  <td><%= approval_status_badge(approval) %></td>
                  <td class="text-nowrap"><%= l(approval.decided_at, format: :short) %></td>
                  <td>
                    <% if policy(approval).document? %>
                      <%= link_to document_approval_path(approval, format: :pdf), title: t("approval_document.link"), aria: { label: t("approval_document.link") } do %>
                        <%= icon("fa-file-pdf") %>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% else %>
      <p class="sg-empty-compact"><%= t("approvals.index.decided_empty") %></p>
    <% end %>
  </section>
</div>
