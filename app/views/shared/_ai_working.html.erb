<%# Inline state while a background AI job runs. Replaced automatically by the job's broadcast refresh. %>
<div class="sg-ai-working" role="status">
  <%= image_tag "mascot/research.webp", alt: "", width: 96, height: 64 %>
  <div>
    <strong><%= t("shared.ai_working.title") %><span class="sg-dots" aria-hidden="true"><span></span><span></span><span></span></span></strong>
    <p class="mb-0"><%= t("shared.ai_working.body", message: message) %></p>
  </div>
</div>
