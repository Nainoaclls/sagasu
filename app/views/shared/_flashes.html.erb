<%# Toasts, announced politely by screen readers, auto-close, pause on hover/focus.
    #flashes: messages of this page load (flash). #toasts: Turbo Stream / broadcast target, kept across
    page refreshes (data-turbo-permanent) so a broadcast toast is not wiped by the morph that follows. %>
<div class="sg-toasts" aria-live="polite" aria-atomic="false">
  <div id="flashes">
    <% flash_toasts.each_key do |type| %>
      <%= render "shared/toast", type: type, message: flash[type] if flash[type].present? %>
    <% end %>
  </div>
  <div id="toasts" data-turbo-permanent></div>
</div>
